# GraphShield Backend Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# APP SETTINGS
# ============================================
APP_NAME=GraphShield
APP_VERSION=3.0.0
DEBUG=false
API_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ============================================
# SECURITY (REQUIRED)
# ============================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your-64-character-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
API_KEY_PREFIX=gs_
BCRYPT_ROUNDS=12

# API Keys (comma-separated for quick testing)
# In production, create via API after registration
API_KEYS=

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ============================================
# DATABASE
# ============================================
# Option 1: Local PostgreSQL (Docker Compose)
USE_CLOUD_SQL=false
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/graphshield

# Option 2: Google Cloud SQL (uncomment and configure)
# USE_CLOUD_SQL=true
# CLOUD_SQL_INSTANCE=your-project:region:instance-name
# DB_USER=postgres
# DB_PASS=your-db-password
# DB_NAME=graphshield
# PRIVATE_IP=false
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# SQLite fallback (dev only)
SQLITE_PATH=graphshield.db

# ============================================
# REDIS / CELERY
# ============================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ============================================
# MINIO / S3 STORAGE
# ============================================
# Option 1: Local MinIO (Docker Compose)
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=graphshield
MINIO_SECURE=false

# Option 2: AWS S3 (uncomment and configure)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1

# ============================================
# ML MODELS
# ============================================
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=openai
EASYOCR_LANGUAGES=en,hi
EMBEDDING_DIM=512

# ============================================
# VECTOR SEARCH
# ============================================
PGVECTOR_HNSW_M=16
PGVECTOR_HNSW_EF_CONSTRUCTION=64
FAISS_NLIST=100
SIMILARITY_THRESHOLDS={"exact":5,"near_duplicate":0.85,"semantic":0.70}

# ============================================
# PROCESSING
# ============================================
MAX_FILE_SIZE_MB=100
MAX_FIGURES_PER_PAPER=50
WORKER_CONCURRENCY_HIGH=2
WORKER_CONCURRENCY_DEFAULT=4
WORKER_CONCURRENCY_LOW=4

# ============================================
# SHODHGANGA
# ============================================
SHODHGANGA_SYNC_ENABLED=true
SHODHGANGA_SYNC_CRON="0 2 * * 0"

# ============================================
# WEBHOOKS
# ============================================
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=3

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# EXPORTS
# ============================================
EXPORTS_DIR=exports